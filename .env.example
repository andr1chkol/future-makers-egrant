APP_MODE=fixture
DATABASE_URL=postgresql+psycopg://egrant:local-development-only@localhost:55433/egrant
DB_PORT=55433
FILE_STORAGE_PATH=.private/files
PUBLIC_ORIGIN=http://localhost:5173
DEV_AUTH_BYPASS=true
COOKIE_SECURE=false
# Set a randomly generated value of at least 24 characters before disabling the bypass.
ACCESS_CODE=
OPENAI_API_KEY=
OPENAI_MODEL=
OCR_BASE_URL=
OCR_API_KEY=
EGRANT_BASE_URL=
EGRANT_TOKEN=
# Local Compose-only database credential; never reuse outside your machine.
POSTGRES_PASSWORD=local-development-only

# Documents: API and worker receive all DOCUMENT_* settings via Compose env_file.
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_MAX_BATCH_FILES=20
DOCUMENT_MAX_BATCH_BYTES=41943040
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_ROWS=10000
DOCUMENT_MAX_COLUMNS=256
DOCUMENT_MAX_CELLS=100000
DOCUMENT_MAX_SHEETS=50
DOCUMENT_MAX_ZIP_FILES=2000
DOCUMENT_MAX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_MAX_COMPRESSION_RATIO=100
DOCUMENT_MAX_PIXELS=25000000
DOCUMENT_MAX_TEXT_CHARS=2000000
DOCUMENT_PROCESSING_SECONDS=40
DOCUMENT_VALIDATION_SECONDS=10
DOCUMENT_OCR_SECONDS=10
DOCUMENT_OCR_PROVIDER=disabled
# Linux image includes Tesseract plus Slovak and English data. Explicitly opt in.
# DOCUMENT_OCR_EXECUTABLE=/usr/bin/tesseract
DOCUMENT_OCR_LANGUAGES=slk+eng
