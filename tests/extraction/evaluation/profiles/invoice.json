  "scalarFields": [
    {
      "key": "invoice_number",
      "label": "Číslo faktúry",
      "type": "string",
      "description": "Invoice number assigned by the supplier",
      "required": true,
      "targetTag": "invoice_number"
    },
    {
      "key": "supplier",
      "label": "Dodávateľ",
      "type": "string",
      "description": "Name of the supplier (seller, issuer, Dodávateľ) without address",
      "required": true,
      "targetTag": "supplier"
    },
    {
      "key": "buyer",
      "label": "Odberateľ",
      "type": "string",
      "description": "Name of the buyer (customer, recipient, Odberateľ) without address",
      "required": true,
      "targetTag": "buyer"
    },
    {
      "key": "issue_date",
      "label": "Dátum vystavenia",
      "type": "date",
      "description": "Date the invoice was issued",
      "required": true,
      "targetTag": "issue_date"
    },
    {
      "key": "due_date",
      "label": "Dátum splatnosti",
      "type": "date",
      "description": "Payment due date",
      "required": false,
      "targetTag": "due_date"
    },
    {
      "key": "purchase_order",
      "label": "Objednávka",
      "type": "string",
      "description": "Buyer's purchase order number",
      "required": false,
      "targetTag": "purchase_order"
    },
    {
      "key": "net_total",
      "label": "Základ dane",
      "type": "money",
      "description": "Total without VAT (tax base)",
      "required": true,
      "targetTag": "net_total"
    },
    {
      "key": "vat_total",
      "label": "DPH",
      "type": "money",
      "description": "VAT amount only",
      "required": true,
      "targetTag": "vat_total"
