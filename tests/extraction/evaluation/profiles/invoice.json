  "tableFields": [
    {
      "key": "items",
      "label": "Položky",
      "targetTag": "items",
      "writeMode": "append",
      "columns": [
        {
          "key": "description",
          "label": "Popis",
          "type": "string",
          "description": "Item description",
          "required": true,
          "targetTag": "description"
        },
        {
          "key": "quantity",
          "label": "Množstvo",
          "type": "decimal",
          "description": "Quantity",
          "required": true,
          "targetTag": "quantity"
        },
        {
          "key": "unit_price",
          "label": "Jednotková cena",
          "type": "money",
          "description": "Unit price without VAT",
          "required": true,
          "targetTag": "unit_price"
